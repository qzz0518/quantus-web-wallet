+    /// Variant index shared by the runtime's signature and signer enums.
+    pub const fn signature_variant(self) -> u8 {
+        match self {
+            Scheme::MlDsa65 => SIG_VARIANT_ML_DSA_65,
+            Scheme::MlDsa87 => SIG_VARIANT_ML_DSA_87,
+        }
+    }
