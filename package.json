{
  "name": "quantus-web-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5189 --strictPort",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "preview": "vite preview --host 127.0.0.1 --port 5189 --strictPort",
    "test": "bun test ./tests ./src/crypto ./src/lib/chain.test.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@polkadot/api": "16.5.6",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@scure/bip39": "2.0.1",
    "lucide-react": "0.577.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "wrangler": "4.125.0"
  },
  "description": "A browser wallet for Quantus with multiple accounts, transfers and encrypted local storage.",
  "license": "GPL-3.0-only",
  "homepage": "https://qtc.zezn.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzz0518/quantus-web-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/qzz0518/quantus-web-wallet/issues"
  },
  "packageManager": "bun@1.4.0"
}
