{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quantus-web-wallet",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "qtc.zezn.dev/*",
      "zone_name": "zezn.dev"
    }
  ]
}
